diff --git a/lib/screens/private_screen.dart b/lib/screens/private_screen.dart
new file mode 100644
index 0000000..4505ee0
--- /dev/null
+++ b/lib/screens/private_screen.dart
@@ -0,0 +1,185 @@
+import 'package:flutter/material.dart';
+
+import '../models/video_info.dart';
+import '../services/api_service.dart';
+import '../utils/device_utils.dart';
+import '../utils/font_utils.dart';
+import '../widgets/video_card.dart';
+
+class PrivateScreen extends StatefulWidget {
+  final ValueChanged<VideoInfo> onVideoTap;
+
+  const PrivateScreen({super.key, required this.onVideoTap});
+
+  @override
+  State<PrivateScreen> createState() => _PrivateScreenState();
+}
+
+class _PrivateScreenState extends State<PrivateScreen> {
+  bool _loading = true;
+  PrivateAccess? _access;
+  PrivateCatalog? _catalog;
+  String? _selectedSource;
+  late final ScrollController _scrollController;
+  bool _loadingMore = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _scrollController = ScrollController()..addListener(_loadNextPage);
+    _load();
+  }
+
+  @override
+  void dispose() {
+    _scrollController.dispose();
+    super.dispose();
+  }
+
+  Future<void> _loadNextPage() async {
+    final catalog = _catalog;
+    if (_loadingMore || catalog == null || catalog.page >= catalog.pageCount) return;
+    if (_scrollController.position.extentAfter > 320) return;
+    setState(() => _loadingMore = true);
+    final nextPage = await ApiService.getPrivateCatalog(
+      source: _selectedSource,
+      page: catalog.page + 1,
+    );
+    if (!mounted || nextPage == null) return;
+    setState(() {
+      _catalog = PrivateCatalog(
+        items: [...catalog.items, ...nextPage.items],
+        page: nextPage.page,
+        pageCount: nextPage.pageCount,
+      );
+      _loadingMore = false;
+    });
+  }
+
+  Future<void> _load({String? source, int page = 1}) async {
+    setState(() => _loading = true);
+    final access = _access ?? await ApiService.getPrivateAccess();
+    if (!access.allowed || access.sources.isEmpty) {
+      if (mounted) {
+        setState(() {
+          _access = access;
+          _catalog = null;
+          _loading = false;
+        });
+      }
+      return;
+    }
+
+    final selectedSource = source ?? _selectedSource ?? access.sources.first.key;
+    final catalog = await ApiService.getPrivateCatalog(
+      source: selectedSource,
+      page: page,
+    );
+    if (!mounted) return;
+    setState(() {
+      _access = access;
+      _selectedSource = selectedSource;
+      _catalog = catalog;
+      _loading = false;
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (_loading) return const Center(child: CircularProgressIndicator());
+
+    final access = _access;
+    if (access == null || !access.allowed) return _buildMessage('无权访问私密内容');
+    if (access.sources.isEmpty) return _buildMessage('私密库暂时没有可用资源');
+    if (_catalog == null) return _buildMessage('私密库暂时无法读取');
+
+    return RefreshIndicator(
+      onRefresh: () => _load(source: _selectedSource),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Padding(
+            padding: const EdgeInsets.fromLTRB(16, 20, 16, 8),
+            child: Text(
+              '私密',
+              style: FontUtils.poppins(
+                fontSize: 22,
+                fontWeight: FontWeight.w700,
+                color: const Color(0xFF27AE60),
+              ),
+            ),
+          ),
+          SizedBox(
+            height: 44,
+            child: ListView.separated(
+              scrollDirection: Axis.horizontal,
+              padding: const EdgeInsets.symmetric(horizontal: 16),
+              itemCount: access.sources.length,
+              separatorBuilder: (_, __) => const SizedBox(width: 8),
+              itemBuilder: (context, index) {
+                final source = access.sources[index];
+                return ChoiceChip(
+                  label: Text(source.name),
+                  selected: source.key == _selectedSource,
+                  selectedColor: const Color(0xFF27AE60).withOpacity(0.18),
+                  onSelected: (_) => _load(source: source.key),
+                );
+              },
+            ),
+          ),
+          Expanded(child: _buildCatalog()),
+        ],
+      ),
+    );
+  }
+
+  Widget _buildCatalog() {
+    final catalog = _catalog!;
+    if (catalog.items.isEmpty) return _buildMessage('当前私密源没有可播放内容');
+
+    return LayoutBuilder(
+      builder: (context, constraints) {
+        final columns = DeviceUtils.getTabletColumnCount(context);
+        const padding = 16.0;
+        const spacing = 12.0;
+        final width = (constraints.maxWidth - padding * 2 - spacing * (columns - 1)) / columns;
+
+        return GridView.builder(
+          controller: _scrollController,
+          padding: const EdgeInsets.all(padding),
+          gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
+            crossAxisCount: columns,
+            childAspectRatio: 1 / 2,
+            crossAxisSpacing: spacing,
+            mainAxisSpacing: DeviceUtils.isTablet(context) ? 0 : 16,
+          ),
+          itemCount: catalog.items.length + (_loadingMore ? 1 : 0),
+          itemBuilder: (context, index) {
+            if (index == catalog.items.length) {
+              return const Center(child: CircularProgressIndicator());
+            }
+            final result = catalog.items[index];
+            final video = result.toVideoInfo();
+            return VideoCard(
+              key: ValueKey('${result.source}_${result.id}'),
+              videoInfo: video,
+              from: 'search',
+              cardWidth: width,
+              onTap: () => widget.onVideoTap(video),
+            );
+          },
+        );
+      },
+    );
+  }
+
+  Widget _buildMessage(String message) {
+    return Center(
+      child: Text(
+        message,
+        style: FontUtils.poppins(fontSize: 16, color: const Color(0xFF7F8C8D)),
+      ),
+    );
+  }
+}
