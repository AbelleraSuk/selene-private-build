+  /// 读取服务端的私密访问权限。权限由 LunaTV 的站长账号与“私密”用户组统一控制。
+  static Future<PrivateAccess> getPrivateAccess() async {
+    final response = await get<PrivateAccess>(
+      '/api/private/access',
+      fromJson: (data) => PrivateAccess.fromJson(data as Map<String, dynamic>),
+    );
+
+    return response.success && response.data != null
+        ? response.data!
+        : const PrivateAccess(allowed: false);
+  }
+
+  /// 获取 LunaTV 私密库的当前视频源目录。
+  static Future<PrivateCatalog?> getPrivateCatalog({
+    String? source,
+    int page = 1,
+  }) async {
+    final query = <String, String>{'page': '$page'};
+    if (source != null && source.isNotEmpty) query['source'] = source;
+
+    final response = await get<PrivateCatalog>(
+      '/api/private/catalog',
+      queryParameters: query,
+      fromJson: (data) => PrivateCatalog.fromJson(data as Map<String, dynamic>),
+    );
+
+    return response.success ? response.data : null;
+  }
