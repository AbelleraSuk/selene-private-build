+class PrivateSource {
+  final String key;
+  final String name;
+
+  const PrivateSource({required this.key, required this.name});
+
+  factory PrivateSource.fromJson(Map<String, dynamic> json) {
+    return PrivateSource(
+      key: json['key'] as String? ?? '',
+      name: json['name'] as String? ?? '',
+    );
+  }
+}
+
+class PrivateAccess {
+  final bool allowed;
+  final List<PrivateSource> sources;
+
+  const PrivateAccess({required this.allowed, this.sources = const []});
+
+  factory PrivateAccess.fromJson(Map<String, dynamic> json) {
+    final sourceList = json['sources'] as List<dynamic>? ?? [];
+    return PrivateAccess(
+      allowed: json['allowed'] as bool? ?? false,
+      sources: sourceList
+          .map((item) => PrivateSource.fromJson(item as Map<String, dynamic>))
+          .toList(),
+    );
+  }
+}
+
+class PrivateCatalog {
+  final List<SearchResult> items;
+  final int page;
+  final int pageCount;
+
+  const PrivateCatalog({
+    required this.items,
+    required this.page,
+    required this.pageCount,
+  });
+
+  factory PrivateCatalog.fromJson(Map<String, dynamic> json) {
+    final items = json['items'] as List<dynamic>? ?? [];
+    return PrivateCatalog(
+      items: items
+          .map((item) => SearchResult.fromJson(item as Map<String, dynamic>))
+          .toList(),
+      page: json['page'] as int? ?? 1,
+      pageCount: json['pageCount'] as int? ?? 1,
+    );
+  }
+}
